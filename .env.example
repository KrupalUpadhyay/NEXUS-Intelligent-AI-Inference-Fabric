# Copy to backend/.env for non-Docker development. Do not commit real secrets.
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_SEMANTIC_CACHE_THRESHOLD=0.92
NEXUS_SEMANTIC_CACHE_BACKEND=memory
NEXUS_OLLAMA_BASE_URL=http://localhost:11434
NEXUS_OLLAMA_MODEL=gemma3:latest
NEXUS_DEFAULT_BACKEND=ollama-gemma
